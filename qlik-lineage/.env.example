# Copy this file to ".env" and fill in the values. NEVER put real secrets in
# .env.example, and NEVER commit .env (it is gitignored).

# --- Qlik Cloud tenant + OAuth machine-to-machine (M2M) client ---
# Create the M2M client in the Qlik Cloud Management Console under
# Identity & access > API keys / OAuth clients. It authenticates as itself
# (client credentials grant) — no personal account and no long-lived personal
# API key involved, mirroring the Power BI service principal on the other tool.
QLIK_TENANT_URL=https://your-tenant.your-region.qlikcloud.com
QLIK_OAUTH_CLIENT_ID=

# --- Credential source: configure exactly ONE of the options below ---

# OPTION 1 (RECOMMENDED) — client secret stored in Azure Key Vault.
# The secret never lives in code or env. Your own identity (az login / VS Code /
# managed identity) authenticates to the vault; the vaulted secret then
# authenticates the Qlik OAuth client. Reuses the same vault as the Power BI
# tool if you like — just a different secret name.
KEY_VAULT_URL=
KEY_VAULT_SECRET_NAME=

# OPTION 2 (LOCAL PROTOTYPING ONLY) — raw client secret in env.
# Use only on your own machine while testing. Do not share, do not commit.
# QLIK_OAUTH_CLIENT_SECRET=

# Where extracted lineage snapshots land. Local folder for now.
OUTPUT_DIR=./data
