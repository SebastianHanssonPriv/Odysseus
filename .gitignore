# Throwaway API probes. qlik_audit_probe_run.py has a live tenant API key
# pasted into it, so nothing matching this pattern may ever be committed.
*_probe.py
*_probe_run.py
# probe_qvd_lineage.py has a fill-in block for a tenant API key, so it is
# handed over as a file and never tracked, for the same reason.
probe_qvd_lineage.py

# The probe's own transcript. It holds no key, but it names internal QVD
# paths and app GUIDs, so it stays local.
probe_output.txt
# Where the probes read the API key from, so it never sits in a script
# that might get attached to a message.
qlik_key.txt

__pycache__/
*.pyc
build/
dist/
*.spec.bak
