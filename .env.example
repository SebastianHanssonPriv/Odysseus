# Copy this file to ".env" for the UNATTENDED daily collector (collect_daily.bat /
# `python cli.py collect`). The desktop app does NOT use this file — it reads
# credentials from Settings. This is only for the scheduled, headless run.
# NEVER put real secrets in .env.example, and NEVER commit .env.

# --- Power BI service principal (Entra app registration) ---
PBI_TENANT_ID=
PBI_CLIENT_ID=

# --- Credential source: configure exactly ONE of the options below ---

# OPTION 1 (RECOMMENDED for an unattended task) — client secret in Azure Key Vault.
# The machine/user running the task authenticates to the vault (az login / managed
# identity); the vaulted secret then authenticates the Power BI service principal.
KEY_VAULT_URL=
KEY_VAULT_SECRET_NAME=

# OPTION 2 (LOCAL TESTING ONLY) — raw client secret in env. Do not share/commit.
# PBI_CLIENT_SECRET=

# OPTION 3 (AZURE / FABRIC) — no secret. Leave the above blank and set:
# PBI_AUTH_MODE=managed_identity

# Where collected data lands. Point this at the SAME folder the desktop app uses,
# so the in-app Usage dashboard sees the scheduled collections too:
#   <your app Output folder>\powerbi_data
# e.g. OUTPUT_DIR=C:\Users\sebastian.hansson\OneDrive - BUFAB\_OutputFolder\powerbi_data
OUTPUT_DIR=./data
