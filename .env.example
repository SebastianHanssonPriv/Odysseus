# Copy this file to ".env" and fill in the values. NEVER put real secrets in
# .env.example, and NEVER commit .env (it is gitignored).
#
# This file covers both platforms. Fill in only the section(s) for the
# command you're actually running -- e.g. skip the Qlik section entirely if
# you only ever run `odysseus powerbi ...`.

# =====================================================================
# Power BI (odysseus powerbi ...)
# =====================================================================

# --- Service principal (Entra app registration) ---
PBI_TENANT_ID=
PBI_CLIENT_ID=

# --- Credential source: configure exactly ONE of the options below ---

# OPTION 1 (RECOMMENDED) — client secret stored in Azure Key Vault.
PBI_KEY_VAULT_URL=
PBI_KEY_VAULT_SECRET_NAME=

# OPTION 2 (LOCAL PROTOTYPING ONLY) — raw client secret in env.
# PBI_CLIENT_SECRET=

# OPTION 3 (FABRIC / AZURE) — no secret at all; the runtime identity must
# itself be the service principal added to the Power BI admin security group.
# PBI_AUTH_MODE=managed_identity

# =====================================================================
# Qlik Cloud (odysseus qlik ...)
# =====================================================================

# --- OAuth machine-to-machine (M2M) client ---
QLIK_TENANT_URL=https://your-tenant.your-region.qlikcloud.com
QLIK_OAUTH_CLIENT_ID=

# --- Credential source: configure exactly ONE of the options below ---

# OPTION 1 (RECOMMENDED) — client secret stored in Azure Key Vault.
# Can be the same vault as PBI_KEY_VAULT_URL above -- just a different
# secret name, since the two platforms' credentials are never the same
# secret.
QLIK_KEY_VAULT_URL=
QLIK_KEY_VAULT_SECRET_NAME=

# OPTION 2 (LOCAL PROTOTYPING ONLY) — raw client secret in env.
# QLIK_OAUTH_CLIENT_SECRET=

# =====================================================================
# Shared
# =====================================================================

# Where collected/extracted data lands. Power BI writes under
# <OUTPUT_DIR>/activity_events, /raw, /analytics; Qlik writes under
# <OUTPUT_DIR>/lineage -- no collision between the two.
OUTPUT_DIR=./data
